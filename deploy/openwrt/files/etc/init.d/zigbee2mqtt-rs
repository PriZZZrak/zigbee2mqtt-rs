#!/bin/sh /etc/rc.common
# procd service for zigbee2mqtt-rs with explicit lazy-converter paths.
# Do not enable while the Node.js Zigbee2MQTT service owns the serial port.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/zigbee2mqtt-rs
DATA_DIR=/etc/zigbee2mqtt
ARTIFACT_DIR=/usr/share/zigbee2mqtt-rs/artifact
HERDSMAN_DIR=/usr/share/zigbee2mqtt-rs/herdsman
STATE_DIR=/var/lib/zigbee2mqtt-rs

start_service() {
	[ -x "$PROG" ] || return 1
	mkdir -p "$STATE_DIR/cache" "$STATE_DIR/runtime"

	procd_open_instance
	procd_set_param command /bin/sh -c "ulimit -v 196608; exec $PROG"
	procd_set_param env \
		Z2M_DATA_DIR="$DATA_DIR" \
		Z2M_CONVERTER_LAZY=1 \
		Z2M_CONVERTER_TRANSPORT=endpoint \
		Z2M_CONVERTER_ARTIFACT_DIR="$ARTIFACT_DIR" \
		Z2M_CONVERTER_HERDSMAN_DIR="$HERDSMAN_DIR" \
		Z2M_CONVERTER_CACHE_DIR="$STATE_DIR/cache" \
		Z2M_CONVERTER_RUNTIME_DIR="$STATE_DIR/runtime" \
		Z2M_CONVERTER_ALLOW_NETWORK=0
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "zigbee2mqtt-rs"
}
