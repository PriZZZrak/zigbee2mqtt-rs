#!/bin/sh /etc/rc.common
# OpenWrt service for the Rust Zigbee2MQTT port.
START=99
USE_PROCD=1

CONFIG_FILE="${ZIGBEE2MQTT_DATA:-/etc/zigbee2mqtt}/configuration.yaml"

start_service() {
	# Wait for the serial adapter referenced in configuration.yaml (cp210x/CH341
	# enumeration can lag procd init by several seconds).
	if [ -r "$CONFIG_FILE" ]; then
		port=$(awk '/^[[:space:]]*port:[[:space:]]*\// {print $2; exit}' "$CONFIG_FILE")
		if [ -n "$port" ]; then
			i=0
			while [ ! -e "$port" ] && [ $i -lt 60 ]; do
				sleep 1
				i=$((i + 1))
			done
		fi
	fi

	procd_open_instance
	procd_set_param env \
		HOME=/root \
		ZIGBEE2MQTT_DATA=/etc/zigbee2mqtt/ \
		ZIGBEE2MQTT_FRONTEND_ASSETS=/usr/share/zigbee2mqtt/windfront
	procd_set_param command /usr/bin/zigbee2mqtt-rs
	# Unlimited respawn: keep retrying while the adapter/broker settles.
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 60
	procd_close_instance
}
