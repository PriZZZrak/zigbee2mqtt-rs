#!/bin/sh /etc/rc.common
# Exclusive ownership of the Zigbee serial port. Do not run the Node.js
# Zigbee2MQTT service at the same time.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/zigbee2mqtt-rs
DATA_DIR=/etc/zigbee2mqtt
SHARE_DIR=/usr/share/zigbee2mqtt-rs
STATE_DIR=/var/lib/zigbee2mqtt-rs
MODE_FILE=/etc/zigbee2mqtt-rs/mode

mode() {
	local value=on-demand
	[ -r "$MODE_FILE" ] && value=$(cat "$MODE_FILE")
	case "$value" in
		on-demand) echo "https 1" ;;
		offline) echo "file 0" ;;
		*) echo "invalid mode '$value' in $MODE_FILE" >&2; return 1 ;;
	esac
}

start_service() {
	[ -x "$PROG" ] || return 1
	set -- $(mode) || return 1
	fetch=$1
	network=$2
	mkdir -p "$STATE_DIR/cache" "$STATE_DIR/runtime"

	procd_open_instance
	# ulimit -v bounds virtual address space; the measured Routerich VmPeak is
	# recorded in docs/hil-readiness.md. RSS is monitored during HIL.
	procd_set_param command /bin/sh -c "ulimit -v 131072; exec $PROG"
	procd_set_param env \
		Z2M_DATA_DIR="$DATA_DIR" \
		Z2M_CONVERTER_LAZY=1 \
		Z2M_CONVERTER_TRANSPORT=endpoint \
		Z2M_CONVERTER_ARTIFACT_DIR="$SHARE_DIR/artifact" \
		Z2M_CONVERTER_HERDSMAN_DIR="$SHARE_DIR/herdsman" \
		Z2M_CONVERTER_CACHE_DIR="$STATE_DIR/cache" \
		Z2M_CONVERTER_RUNTIME_DIR="$STATE_DIR/runtime" \
		Z2M_CONVERTER_FETCH="$fetch" \
		Z2M_CONVERTER_ALLOW_NETWORK="$network"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "zigbee2mqtt-rs"
}
